rules_version = '2';
// NOMAD Firestore rules. Everything not listed here is blocked.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function data() { return request.resource.data; }
    function str(f, n) { return data()[f] is string && data()[f].size() <= n; }
    function num(f) { return data()[f] is number; }
    function isOwner() { return signedIn() && resource.data.uid == me(); }
    // Owner moderation: add your Firebase user ID here to delete anything. Leave as is to keep it off.
    function isAdmin() { return signedIn() && me() in ['PASTE_YOUR_UID_HERE']; }

    // ── NOMAD ID: unique @usernames ──
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && name.matches('^[a-z0-9_.]{3,20}$') && data().uid == me() && data().u == name
        && data().keys().hasOnly(['uid','u','av','oh','ts']) && str('av', 20) && str('oh', 64) && data().ts == request.time;
      // owner can change avatar / clear proof; moving to a new phone needs the secret only the encrypted backup holds
      allow update: if signedIn() && (
        (resource.data.uid == me() && data().diff(resource.data).affectedKeys().hasOnly(['av','p']))
        || (data().uid == me() && data().diff(resource.data).affectedKeys().hasOnly(['uid','oh','p']) && data().p is string
            && hashing.sha256(data().p).toHexString().lower() == resource.data.oh && data().oh != resource.data.oh));
      allow delete: if isAdmin();
    }
    // ── Encrypted backups (AES-256 on the phone; id derived from the recovery key). Get by id only — no listing. ──
    match /backups/{id} {
      allow get: if true;
      allow create, update: if signedIn() && id.matches('^[0-9a-f]{40}$') && data().keys().hasOnly(['d','iv','z','v','ts'])
        && str('d', 1000000) && str('iv', 40) && data().ts == request.time;
    }
    // ── Founders: first 100 NOMAD IDs. Counter and founder doc must change together. ──
    match /founders/{name} {
      allow read: if true;
      allow create: if signedIn() && get(/databases/$(db)/documents/usernames/$(name)).data.uid == me()
        && data().keys().hasOnly(['n','ts']) && data().n is int && data().n <= 100 && data().ts == request.time
        && data().n == getAfter(/databases/$(db)/documents/meta/founders).data.count;
    }
    match /meta/founders {
      allow read: if true;
      allow create: if signedIn() && data().keys().hasOnly(['count','last']) && data().count == 1
        && !exists(/databases/$(db)/documents/founders/$(data().last)) && existsAfter(/databases/$(db)/documents/founders/$(data().last));
      allow update: if signedIn() && data().keys().hasOnly(['count','last']) && data().count == resource.data.count + 1 && data().count <= 100
        && !exists(/databases/$(db)/documents/founders/$(data().last)) && existsAfter(/databases/$(db)/documents/founders/$(data().last));
    }
    // ── Shared spots ──
    match /community_spots/{id} {
      allow read: if true;
      allow create: if signedIn() && data().uid == me() && data().keys().hasOnly(['name','type','note','lat','lng','alias','uid','likes','ts'])
        && str('name', 60) && str('note', 280) && str('type', 20) && str('alias', 24) && num('lat') && num('lng') && data().likes == 0 && data().ts == request.time;
      // one like per person: the like doc and the +1 must land together
      allow update: if signedIn() && data().diff(resource.data).affectedKeys().hasOnly(['likes']) && data().likes == resource.data.likes + 1
        && !exists(/databases/$(db)/documents/spot_likes/$(id + '_' + me())) && existsAfter(/databases/$(db)/documents/spot_likes/$(id + '_' + me()));
      allow delete: if isOwner() || isAdmin();
    }
    match /spot_likes/{lid} {
      allow create: if signedIn() && lid == data().spot + '_' + me() && data().uid == me() && data().keys().hasOnly(['spot','uid']);
    }
    // ── Meetups ──
    match /community_events/{id} {
      allow read: if true;
      allow create: if signedIn() && data().uid == me() && data().keys().hasOnly(['title','place','when','note','alias','uid','going','ts'])
        && str('title', 60) && str('place', 60) && str('when', 30) && str('note', 280) && str('alias', 24) && data().going == [me()] && data().ts == request.time;
      // you can only add or remove yourself
      allow update: if signedIn() && data().diff(resource.data).affectedKeys().hasOnly(['going'])
        && data().going.toSet().difference(resource.data.going.toSet()).union(resource.data.going.toSet().difference(data().going.toSet())) == [me()].toSet();
      allow delete: if isOwner() || isAdmin();
    }
    // ── Toilet ratings ──
    match /dunny_votes/{vid} {
      allow read: if true;
      allow create: if signedIn() && vid == data().osm + '_' + me() && data().uid == me() && data().stars is int && data().stars >= 1 && data().stars <= 5;
      allow delete: if isOwner();
    }
    match /dunny/{osm} {
      allow read: if true;
      allow create, update: if signedIn()
        && !exists(/databases/$(db)/documents/dunny_votes/$(osm + '_' + me()))
        && existsAfter(/databases/$(db)/documents/dunny_votes/$(osm + '_' + me()))
        && data().count == (resource == null ? 0 : resource.data.count) + 1
        && data().sum == (resource == null ? 0 : resource.data.sum) + getAfter(/databases/$(db)/documents/dunny_votes/$(osm + '_' + me())).data.stars
        && data().keys().hasOnly(['sum','count','name','lat','lng']);
    }
    // ── Seasonal work board ──
    match /jobs/{id} {
      allow read: if true;
      allow create: if signedIn() && data().uid == me() && data().ts == request.time
        && data().keys().hasOnly(['title','kind','town','pay','start','desc','accom','v88','phone','email','url','lat','lng','alias','uid','ts'])
        && str('title', 70) && str('town', 40) && str('pay', 40) && str('desc', 800) && str('phone', 20) && str('email', 80) && str('url', 200) && str('alias', 24) && num('lat') && num('lng');
      allow delete: if isOwner() || isAdmin();
    }
    // ── Nomad fuel prices: one doc per person per servo per grade, pump-sane prices, server time only ──
    match /fuel_reports/{id} {
      allow read: if true;
      allow create, update: if signedIn() && data().keys().hasOnly(['sid','g','p','uid','cell','lat','lng','near','ts'])
        && data().uid == me() && id == data().sid + '_' + data().g + '_' + me()
        && data().g in ['DSL','U91','E10','P95','P98','PDSL','LPG'] && num('p') && data().p >= 0.6 && data().p <= 3.6
        && str('sid', 24) && str('cell', 12) && data().ts == request.time;
      allow delete: if isAdmin();
    }
    // ── Reports to the owner ──
    match /reports/{id} {
      allow create: if signedIn() && data().keys().hasOnly(['path','by','ts']) && data().by == me() && str('path', 120);
      allow read, delete: if isAdmin();
    }
    match /pro_waitlist/{id} {
      allow create: if data().keys().hasOnly(['email','plan','ts']) && str('email', 120);
      allow read, delete: if isAdmin();
    }
  }
}
