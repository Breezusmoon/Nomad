rules_version = '2';
// NOMAD Firestore rules — paste into Firebase console → Firestore Database → Rules → Publish.
// Also turn on: Authentication → Sign-in method → Anonymous → Enable.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && resource.data.uid == request.auth.uid; }
    function short(f, n) { return request.resource.data[f] is string && request.resource.data[f].size() <= n; }
    // Add your own UID here after you post once (Firebase console → Authentication → Users) to get admin delete powers.
    function isAdmin() { return signedIn() && request.auth.uid in ['PASTE_YOUR_UID_HERE']; }

    match /nomad_chat/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && short('text', 400) && short('alias', 24)
                    && (request.resource.data.type in ['msg', 'join'] || isAdmin())
                    // a @username on a message must belong to the sender
                    && (!('u' in request.resource.data) || get(/databases/$(db)/documents/usernames/$(request.resource.data.u)).data.uid == request.auth.uid);
      allow delete: if isOwner() || isAdmin();
    }
    match /nomad_presence/{uid} {
      allow read: if true;
      allow write: if signedIn() && uid == request.auth.uid;
    }
    match /community_spots/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && short('name', 60) && short('note', 280) && request.resource.data.likes == 0;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                    && request.resource.data.likes == resource.data.likes + 1;
      allow delete: if isOwner() || isAdmin();
    }
    match /community_events/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && short('title', 60) && short('note', 280);
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going']);
      allow delete: if isOwner() || isAdmin();
    }
    match /dunny_votes/{vid} {
      allow read: if true;
      allow create: if signedIn() && vid == request.resource.data.osm + '_' + request.auth.uid
                    && request.resource.data.uid == request.auth.uid && request.resource.data.stars is int
                    && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
    }
    match /dunny/{osm} {
      allow read: if true;
      allow create, update: if signedIn()
        && !exists(/databases/$(db)/documents/dunny_votes/$(osm + '_' + request.auth.uid))
        && existsAfter(/databases/$(db)/documents/dunny_votes/$(osm + '_' + request.auth.uid))
        && request.resource.data.count == (resource == null ? 0 : resource.data.count) + 1;
    }
    match /fuel_reports/{id} {
      // One doc per person per servo per grade: id = sid_grade_uid. Price within pump-sane bounds, server timestamp only.
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['sid','g','p','uid','cell','lat','lng','near','ts'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.sid + '_' + request.resource.data.g + '_' + request.auth.uid
        && request.resource.data.g in ['DSL','U91','E10','P95','P98','PDSL','LPG']
        && request.resource.data.p is number && request.resource.data.p >= 0.6 && request.resource.data.p <= 3.6
        && request.resource.data.sid is string && request.resource.data.sid.size() <= 24
        && request.resource.data.cell is string && request.resource.data.cell.size() <= 12
        && request.resource.data.ts == request.time;
      allow delete: if isAdmin();
    }
    // NOMAD ID: unique usernames. oh = sha256 of a secret only the owner's encrypted backup knows (lets them move it to a new phone)
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && name.matches('^[a-z0-9_.]{3,20}$') && request.resource.data.uid == request.auth.uid
        && request.resource.data.u == name && request.resource.data.keys().hasOnly(['uid','u','av','oh','ts']);
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['av','p'])) ||
        (request.resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','oh','p'])
          && hashing.sha256(request.resource.data.p).toHexString().lower() == resource.data.oh && request.resource.data.oh != resource.data.oh));
      allow delete: if isAdmin();
    }
    // Encrypted backups (AES-256, key never leaves the phone). Doc id is derived from the recovery key, so get-only, no listing.
    match /backups/{id} {
      allow get: if true;
      allow create, update: if signedIn() && id.size() == 40 && request.resource.data.d is string && request.resource.data.d.size() < 1000000
        && request.resource.data.keys().hasOnly(['d','iv','z','v','ts']);
    }
    // Founders: first 100 NOMAD IDs get Pro for life. Counter + one doc per username, enforced together.
    match /founders/{name} {
      allow read: if true;
      allow create: if signedIn() && get(/databases/$(db)/documents/usernames/$(name)).data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['n','ts']) && request.resource.data.n <= 100
        && request.resource.data.n == getAfter(/databases/$(db)/documents/meta/founders).data.count;
    }
    match /meta/founders {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['count','last']) && request.resource.data.count == 1
        && !exists(/databases/$(db)/documents/founders/$(request.resource.data.last)) && existsAfter(/databases/$(db)/documents/founders/$(request.resource.data.last));
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['count','last']) && request.resource.data.count == resource.data.count + 1 && request.resource.data.count <= 100
        && !exists(/databases/$(db)/documents/founders/$(request.resource.data.last)) && existsAfter(/databases/$(db)/documents/founders/$(request.resource.data.last));
    }
    match /founders_chat/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && short('text', 400) && short('alias', 24)
        && request.resource.data.type in ['msg', 'join']
        && (isAdmin() || ('u' in request.resource.data
            && get(/databases/$(db)/documents/usernames/$(request.resource.data.u)).data.uid == request.auth.uid
            && exists(/databases/$(db)/documents/founders/$(request.resource.data.u))));
      allow delete: if isOwner() || isAdmin();
    }
    match /reports/{id} { allow create: if signedIn(); allow read, delete: if isAdmin(); }
    match /pro_waitlist/{id} { allow create: if short('email', 120); allow read, delete: if isAdmin(); }
  }
}
